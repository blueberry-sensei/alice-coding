{
  "name": "alice-coding",
  "version": "2.4.10",
  "private": true,
  "description": "Trí nhớ dài hạn + kỷ luật làm việc cho AI coding agent. npm chỉ là lớp vỏ tiện tay — lõi là Python + Docker.",
  "scripts": {
    "doctor": "node tools/cli.js doctor",
    "brain": "node tools/cli.js up",
    "brain:up": "node tools/cli.js up",
    "brain:down": "node tools/cli.js down",
    "brain:restart": "node tools/cli.js restart",
    "brain:status": "node tools/cli.js status",
    "brain:list": "node tools/cli.js list",
    "brain:logs": "node tools/cli.js logs",
    "brain:pull": "node tools/cli.js pull",
    "uninstall": "node tools/cli.js uninstall",
    "uninstall:yes": "node tools/cli.js uninstall --yes",
    "uninstall:keep-cache": "node tools/cli.js uninstall --yes --keep-cache",
    "brain:uninstall": "node tools/cli.js uninstall",
    "reset": "node tools/cli.js reset",
    "reset:yes": "node tools/cli.js reset --yes",
    "verify": "node tools/cli.js verify",
    "verify:fix": "node tools/cli.js verify --fix",
    "sync": "node tools/cli.js sync",
    "sync:rebuild": "node tools/cli.js sync --rebuild",
    "sync:no-verify": "node tools/cli.js sync --no-verify",
    "update": "node tools/cli.js update",
    "update:check": "node tools/cli.js update --check",
    "update:dry": "node tools/cli.js update --dry-run",
    "mcp": "node tools/cli.js mcp",
    "wire": "node tools/wire.js",
    "test:wire": "node --test tools/wire.test.js",
    "manifest": "node tools/cli.js update --gen-manifest"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
