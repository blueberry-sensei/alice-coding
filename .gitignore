# File luật cục bộ của người bảo trì template — KHÔNG ship trong template public
AGENTS.md

# `prompts.md` KHÔNG bị ignore: INITIALIZATION sinh đây là instance của project và
# `npm run wire` dùng nó để tạo entry point chung cho team.

# Artifact thiết kế cục bộ (brainstorming/specs) — không ship
docs/superpowers/

# Python bytecode
__pycache__/
*.pyc
.claude
.codex

# Node — lớp vỏ npm không có dependency nào, lock file là nhiễu
node_modules/
package-lock.json

# --- Runtime của brain: CHỨA SECRET hoặc dữ liệu sinh ra, không commit ---
# brain.config giữ token/JWT của brain.
# SAG_SECRET_KEY KHÔNG còn nằm ở đây: file .env của brain đã chuyển ra thư mục state của
# người dùng (Windows %LOCALAPPDATA%\alice-brain\<BRAIN_ID>\, còn lại ~/.local/state/…),
# và DB nằm trong named volume của Docker. Hai dòng dưới chỉ để dọn tàn dư bản cũ.
brain/brain.config
brain/.sync-state.json
brain/stack/.env
brain/stack/.env.moved
# Log cục bộ của sync/launcher (có thể chứa đường dẫn máy, tên file tri thức).
brain/.logs/
.sag-data/
# Tàn dư bản cũ: launcher trước đây tự clone source vào đây. Nay chỉ kéo image.
brain/stack/alice-brain/
brain/stack/alice-core/
brain/stack/sag/

# --- Cấu hình verify cục bộ theo máy (đường dẫn code root) ---
tools/verify.config

# --- Bản template mới do `tools/update.py` để lại khi có xung đột ---
# Gộp tay xong thì xoá; không commit.
*.new

# LƯU Ý cho người DÙNG template: trong repo project của bạn, thư mục knowledge/
# NÊN được commit (tri thức là tài sản của project) — chỉ trừ các mục ở trên.
